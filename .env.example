# Copiez ce fichier en server/.env puis adaptez.

# Secret maître (>= 32 caractères) : chiffre les clés API au repos. OBLIGATOIRE en production.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Jeton exigé pour créer le premier compte administrateur (recommandé si le serveur est exposé).
SETUP_TOKEN=

PORT=8787
# 127.0.0.1 par défaut : placez un reverse-proxy HTTPS (Caddy, Nginx) devant en production.
HOST=127.0.0.1
# Mettre à 1 derrière un reverse-proxy (pour l'IP réelle et la limitation de débit).
TRUST_PROXY=0

SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=40
DATA_DIR=./data

# Transcription IVTFF proposée par défaut dans la page Corpus.
CORPUS_URL=https://www.voynich.nu/data/ZL3b-n.txt
